{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Myrtos (J-Link, RISC-V)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/os_kernel.elf",
            "servertype": "jlink",
            // LEFT AS RISC-V ON PURPOSE, unlike the compiler paths beside it.
            // This is a J-Link configuration for Hazard3 and it is correct for
            // what it is; the Arm side is debugged with the Debug Probe and
            // OpenOCD instead, which is a different server and a different
            // device name. Changing the path alone would give a working gdb
            // pointed at the wrong core.
            "gdbPath": "${env:HOME}/.pico-sdk/toolchain/RISCV_ZCB_RPI_2_2_0_3/bin/riscv32-unknown-elf-gdb",
            // RP2350_RV32_0 selects Hazard3 core 0. J-Link has four RP2350 devices,
            // _M33_0, _M33_1, _RV32_0 and _RV32_1, and picks the mode by the name.
            "device": "RP2350_RV32_0",
            "interface": "swd",
            // No -connectunderreset. Connecting does a reset-and-halt, and that
            // only works while the chip boots into RISC-V: the boot ROM reads
            // PICOBIN_IMAGE_TYPE_EXE_CPU from the flash image and switches
            // architecture only then. Hence copy_to_ram in CMakeLists -- with
            // no_flash there is no image to switch on, the chip boots into Arm,
            // and the server fails with "Timeout while waiting for core to halt
            // after reset".
            "serverArgs": [
                "-speed", "4000"
            ],
            "runToEntryPoint": "myrtos_kernel_main",
            "showDevDebugOutput": "none"
        }
    ]
}
