{
    "configurations": [
        {
            "name": "Myrtos-RISCV",
            // The compile database rather than a hand-kept list of include
            // paths. It has the exact flags each file was built with -- every
            // -I, every -D -- and cannot drift out of step with the build,
            // because it is the build. Generated by CMAKE_EXPORT_COMPILE_COMMANDS.
            "compileCommands": "${workspaceFolder}/build/compile_commands.json",
            // For files the build does not know about yet, and for headers.
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/build/**",
                "${userHome}/.pico-sdk/sdk/2.3.0/**"
            ],
            // What the SDK's own configuration decided, so PICO_* macros are
            // not all invisible.
            "forcedInclude": [
                "${workspaceFolder}/build/generated/pico_base/pico/config_autogen.h"
            ],
            "defines": [
                "PICO_BOARD=\"adafruit_fruit_jam\"",
                "PICO_PLATFORM=\"rp2350-riscv\"",
                "ARCH_RISCV=1"
            ],
            // RISC-V, not ARM. The import replaced this with arm-none-eabi-gcc,
            // which is a different architecture and a different set of builtin
            // macros. cpptools has no riscv intelliSenseMode, so the mode below
            // is only a fallback -- what matters is that it asks this compiler.
            "compilerPath": "${env:HOME}/.pico-sdk/toolchain/RISCV_ZCB_RPI_2_2_0_3/bin/riscv32-unknown-elf-gcc",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "macos-gcc-arm64"
        }
    ],
    "version": 4
}
