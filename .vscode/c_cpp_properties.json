{
    "configurations": [
        {
            "name": "myrtos",
            // The compile database rather than a hand-kept list of include
            // paths. It has the exact flags each file was built with -- every
            // -I, every -D -- and cannot drift out of step with the build,
            // because it is the build. Generated by CMAKE_EXPORT_COMPILE_COMMANDS.
            "compileCommands": "${workspaceFolder}/build/compile_commands.json",
            // For files the build does not know about yet, and for headers.
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/build/**",
                "${userHome}/.pico-sdk/sdk/2.3.1/**"
            ],
            // What the SDK's own configuration decided, so PICO_* macros are
            // not all invisible.
            "forcedInclude": [
                "${workspaceFolder}/build/generated/pico_base/pico/config_autogen.h"
            ],
            "defines": [
                "PICO_BOARD=\"adafruit_fruit_jam\"",
                "PICO_PLATFORM=\"rp2350-arm-s\""
            ],
            // ARCH_RISCV=1 used to be here too and is gone rather than
            // flipped: nothing in this codebase reads it. The architecture is
            // MYRTOS_ARCH_HERE in common/myrtos_abi.h, which the compiler sets
            // from the real flags -- and for any file the build knows about,
            // compileCommands above wins over these defines anyway. They matter
            // for headers and for files not yet in the build.
            //
            // Arm, because MYRTOS_ARCH in CMakeLists.txt is Arm. This said
            // RISC-V, correctly, while the project was RISC-V-first; the
            // architecture decides a different set of builtin macros, so
            // leaving it behind means IntelliSense reads the code as a machine
            // nobody is building for. It has to be changed by hand alongside
            // MYRTOS_ARCH -- the extension does not know that variable exists.
            "compilerPath": "${env:HOME}/.pico-sdk/toolchain/15_2_Rel1/bin/arm-none-eabi-gcc",
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "macos-gcc-arm64"
        }
    ],
    "version": 4
}
