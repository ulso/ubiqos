+/* LOCAL: these point at WRITABLE globals, which in a UbiqOS module live in each
+   process's own data area -- so the distance from a shared .rodata table to them
+   is not the same for every process, and a relative table cannot express it. A
+   function instead: the compiler addresses each global the way it addresses any
+   other, and there is no table at all. */
+__attribute__((noinline, optimize("O0")))
+struct tcp_pcb **tcp_pcb_list(int i) {
+  /* An if-chain, and the optimiser told to leave it alone. Written as a switch
+     first, GCC gathered the three addresses into a lookup table in .rodata --
+     which is the very thing being avoided. Called rarely; the cost is nothing. */
+  if (i == 0) return &tcp_listen_pcbs.pcbs;
+  if (i == 1) return &tcp_bound_pcbs;
+  if (i == 2) return &tcp_active_pcbs;
+  return &tcp_tw_pcbs;
+}
 
