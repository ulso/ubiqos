build
__pycache__/
!.vscode/*

.DS_Store

# Web pages saved as reference material -- several megabytes of binary each,
# and they cannot be taken out of the history afterwards.
docs/*.webarchive

# Adafruit's own recovery route for the ESP32-C6, downloaded rather than
# built here. 185 kB of somebody else's binary does not belong in this
# history -- see docs/esp-hosted/README.md for where to get it and why.
tools/SerialESPPassthrough.ino.uf2
